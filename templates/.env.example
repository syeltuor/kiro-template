# kiro-template v2.0.0
# Copy to .env (gitignored) and fill in. Key names only here; never commit values.
# Secrets and personal identifiers do NOT go in .env: put them in SSM with
# scripts/setup-params.sh (hidden prompt).

# Project slug: stacks are <PROJECT>-certificate, -data, -auth, -api, -cloudfront
PROJECT=
STAGE=app
AWS_PROFILE=
REGION=eu-west-2
CERT_REGION=us-east-1

# Site
DOMAIN_NAME=
PARENT_DOMAIN=
# Optional: looked up from PARENT_DOMAIN when empty
HOSTED_ZONE_ID=

# Data (only with infra/data-stack.yaml), e.g. MyAppData -> MyAppData-app
TABLE_BASE_NAME=

# Cognito (only with infra/cognito-stack.yaml); prefix is globally unique per region
COGNITO_DOMAIN_PREFIX=
APP_DISPLAY_NAME=

# Optional: latest Lambda-supported Node.js runtime identifier (check at project start)
NODE_RUNTIME=

# SSM prefix (default /<PROJECT>)
PARAM_PREFIX=

# Privacy check: SSM parameter NAMES (relative to PARAM_PREFIX), never values
PRIVACY_PARAMS=
PRIVACY_SECURE_PARAMS=
